{
    "name": "myerscode/acorn-cli",
    "description": "A CLI tool for working with Acorn apps",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Fred Myerscough",
            "email": "oniice@gmail.com"
        }
    ],
    "bin": [
        "acorn-cli"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "myerscode/acorn-framework": "dev-main",
        "myerscode/templex": "dev-main",
        "symfony/process": "^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "myerscode/acorn-testing": "dev-main",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "tests": "vendor/bin/phpunit --testdox --no-coverage --colors=always",
        "test-coverage": "vendor/bin/phpunit --testdox --colors=always",
        "security-audit": "@composer audit"
    },
    "extra": {
        "acorn": {
            "commands": true,
            "listeners": true
        }
    }
}
